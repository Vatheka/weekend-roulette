# demo works without any model downloads or API key.
AGENT_PROVIDER=demo

# For a real local tool-calling LLM, set AGENT_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Or set AGENT_PROVIDER=compatible for your provider's chat-completions endpoint.
# Use the API base ending in /v1 (or your provider's equivalent), not /chat/completions.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_MODEL=
